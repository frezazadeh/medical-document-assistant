# Copy to .env and adjust. Everything has a default, so the app also starts without this file.

# Sent by clients as the X-API-Key header.
MDA_API_KEY=dev-key-change-me

# "ollama" runs fully local. "anthropic" needs ANTHROPIC_API_KEY.
MDA_LLM_PROVIDER=ollama
MDA_OLLAMA_BASE_URL=http://localhost:11434
MDA_OLLAMA_MODEL=qwen2.5:3b

# MDA_LLM_PROVIDER=anthropic
# MDA_ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Retrieval
MDA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MDA_CHUNK_SIZE=900
MDA_CHUNK_OVERLAP=150
# dense = embeddings only, rerank = embeddings + cross-encoder re-ranking
MDA_RETRIEVAL_MODE=rerank
MDA_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MDA_TOP_K=5
MDA_MIN_RELEVANCE=0.5

MDA_DATA_DIR=data
MDA_LOG_LEVEL=INFO
